# Unique project key in SonarQube (set this in your SonarQube UI)
sonar.projectKey=Varun
sonar.projectName=Varun
sonar.projectVersion=1.0

# Source code location
sonar.sources=.

# Exclude test files from analysis
sonar.exclusions=*/tests/*

# Encoding of the source files
sonar.sourceEncoding=UTF-8

# Python coverage report generated by pytest/coverage.py
sonar.python.coverage.reportPaths=coverage.xml

# Optional: where unit test results are stored (JUnit XML format if you use pytest)
# sonar.python.xunit.reportPath=tests/results.xml
